# Kotak Neo market-data credentials
# Quotes and scrip-master data use the consumer key in the current SDK.
# Keep this file private and never commit it.
NEO_CONSUMER_KEY=my key
NEO_ENVIRONMENT=prod

# TOTP/UCC/MPIN are NOT needed for this read-only market-data application.
# They become necessary if you later add order placement or other session-protected functions.
